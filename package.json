{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "A local-first desktop interface for the Pi coding agent",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "Pi Desktop contributors",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist release",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "predev": "node scripts/check-module-updates.mjs && node scripts/check-dev-port.mjs && pnpm clean && pnpm build:main && pnpm build:preload",
    "dev": "concurrently -k -s first -n renderer,main,preload,electron -c cyan,magenta,yellow,green \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:preload\" \"wait-on tcp:5173 file:dist/main/index.js file:dist/preload/index.cjs && node scripts/dev-electron.mjs\"",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "pnpm clean && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "verify:speech-runtime": "node scripts/verify-speech-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "pnpm build && vite build --config vite.e2e.config.ts",
    "test:e2e": "pnpm build:e2e && playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "smoke": "pnpm build && cross-env PI_DESKTOP_SMOKE=1 electron .",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "icons:generate": "python scripts/generate-icons.py",
    "deps:check": "node scripts/check-module-updates.mjs --force",
    "deps:update:speech": "pnpm update --latest transcribe-cpp && pnpm typecheck && pnpm test",
    "package": "pnpm icons:generate && pnpm verify:speech-runtime && pnpm build && electron-builder --dir && pnpm smoke:packaged",
    "dist:artifacts": "pnpm icons:generate && electron-builder",
    "dist": "pnpm icons:generate && pnpm verify:speech-runtime && pnpm build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "transcribe-cpp": "0.1.3",
    "typebox": "1.1.38",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Fate UI",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@transcribe-cpp/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/transcribe-cpp/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@transcribe-cpp/**/*",
      "package.json",
      "LICENSE",
      "FONT_LICENSES.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Fate-UI-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "Fate-UI-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Fate UI uses the microphone to list input devices and record audio for local voice transcription."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icons",
      "artifactName": "Fate-UI-${version}-Linux-${arch}.${ext}"
    }
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
