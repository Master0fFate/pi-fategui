{
  "name": "pi-fategui",
  "version": "0.9.1-beta1",
  "description": "A local-first desktop interface for the Pi coding agent",
  "type": "module",
  "main": "dist/main/index.js",
  "author": {
    "name": "Master0fFate",
    "email": "Master0fFate@users.noreply.github.com"
  },
  "homepage": "https://github.com/Master0fFate/pi-fategui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Master0fFate/pi-fategui.git"
  },
  "bugs": "https://github.com/Master0fFate/pi-fategui/issues",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist release",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "predev": "node scripts/check-module-updates.mjs && node scripts/check-dev-port.mjs && pnpm clean && pnpm build:main && pnpm build:preload",
    "dev": "concurrently -k -s first -n renderer,main,preload,electron -c cyan,magenta,yellow,green \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:preload\" \"wait-on tcp:5173 file:dist/main/index.js file:dist/preload/index.cjs && node scripts/dev-electron.mjs\"",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "verify:version": "node scripts/verify-version.mjs",
    "build": "pnpm verify:version && pnpm clean && pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "verify:speech-runtime": "node scripts/verify-speech-runtime.mjs",
    "prepare:yt-dlp": "node scripts/prepare-yt-dlp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "pnpm build && vite build --config vite.e2e.config.ts",
    "test:e2e": "pnpm build:e2e && playwright test",
    "profile:live": "pnpm build:e2e && node scripts/profile-live-renderer.mjs --runs 3 --label live-profile",
    "verify": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "smoke": "pnpm build && cross-env PI_DESKTOP_SMOKE=1 electron .",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "icons:generate": "python scripts/generate-icons.py",
    "deps:check": "node scripts/check-module-updates.mjs --force",
    "deps:update:speech": "pnpm update --latest transcribe-cpp && pnpm typecheck && pnpm test",
    "package": "pnpm verify:speech-runtime && pnpm prepare:yt-dlp && pnpm build && electron-builder --dir && pnpm smoke:packaged",
    "dist:artifacts": "pnpm prepare:yt-dlp && electron-builder --publish never",
    "dist": "pnpm verify:speech-runtime && pnpm prepare:yt-dlp && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "node-gyp-build": "^4.8.4",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "transcribe-cpp": "0.1.3",
    "typebox": "1.3.9",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Fate UI",
    "executableName": "fate-ui",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./scripts/verify-packaged-native-deps.mjs",
    "extraResources": [
      {
        "from": "PRODVER",
        "to": "PRODVER"
      },
      {
        "from": "build/vendor/yt-dlp",
        "to": ".",
        "filter": [
          "yt-dlp",
          "yt-dlp.exe",
          "yt-dlp-LICENSE",
          "yt-dlp-THIRD_PARTY_LICENSES.txt",
          "yt-dlp-manifest.json"
        ]
      },
      {
        "from": "build/cli",
        "to": "cli"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/@transcribe-cpp/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/transcribe-cpp/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/@transcribe-cpp/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*",
      "node_modules/@earendil-works/pi-coding-agent/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "FONT_LICENSES.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Fate-UI-${version}-Windows-${arch}.${ext}",
      "extraFiles": [
        {
          "from": "build/cli/fate.cmd",
          "to": "fate.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "Fate-UI-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Fate UI uses the microphone to list input devices and record audio for local voice transcription."
      }
    },
    "pkg": {
      "installLocation": "/Applications",
      "scripts": "pkg-scripts",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false,
      "overwriteAction": "upgrade"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons",
      "artifactName": "Fate-UI-${version}-Linux-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "Master0fFate <Master0fFate@users.noreply.github.com>",
      "fpm": [
        "build/cli/fate-linux=/usr/bin/fate"
      ]
    }
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
