#!/bin/sh
set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
contents=$(CDPATH= cd -- "$(dirname -- "$self")/../.." && pwd)

# Parse arguments: --new-instance requests a fully isolated second process;
# the first positional argument is the project folder (default: current dir).
project=""
new_instance=""
for arg in "$@"; do
  case "$arg" in
    --new-instance) new_instance=1 ;;
    --project|--*) ;;
    *) [ -z "$project" ] && project="$arg" ;;
  esac
done
[ -z "$project" ] && project="$PWD"

set -- --project "$project"
[ "$new_instance" ] && set -- "$@" --new-instance
exec "$contents/MacOS/fate-ui" "$@"
